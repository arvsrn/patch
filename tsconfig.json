{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@runic/types/*": ["../runic.design/packages/types/*"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
